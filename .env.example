# =============================================================================
# lilac-ai-router 环境变量模板
#
# 用法：cp .env.example .env  →  填真实值  →  docker compose up -d --build
# .env 已被 .gitignore 忽略；本模板会提交进 git，所以只能放占位符，不要写真值。
#
# 变量命名遵循 Spring Boot relaxed binding：SPRING_DATASOURCE_PASSWORD 会自动
# 映射到 spring.datasource.password，因此同一套变量对 dev 和 prod 都生效。
# =============================================================================

# ------------------------------------------------------------------ 应用
# 激活 application-prod.yml（dev 是默认值，不配就是 dev）
SPRING_PROFILES_ACTIVE=prod
# 宿主机映射到 backend 9090 的端口
SERVER_PORT=9090

# ------------------------------------------------------------------ MySQL
# 容器内 root 密码，仅容器内部与初始化使用
MYSQL_ROOT_PASSWORD=change_me_root
# 业务库名（backend 用 MYSQL_USER 连接这个库）
MYSQL_DATABASE=lilac_ai_router
# 业务账号：compose 会自动授予其对 MYSQL_DATABASE 的全部权限
MYSQL_USER=fund_app
MYSQL_PASSWORD=change_me_app
# 宿主机暴露端口（本地已有 MySQL 时改掉，避免 3306 冲突）
MYSQL_HOST_PORT=3307

# ------------------------------------------------------------------ Redis
REDIS_PASSWORD=change_me_redis
# 宿主机暴露端口（本地已有 Redis 时改掉，避免 6379 冲突）
REDIS_HOST_PORT=6380
# 容器下由 compose 覆盖为 redis:6379，本地裸跑时改 127.0.0.1
SPRING_DATA_REDIS_HOST=redis
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_DATABASE=0
SPRING_SESSION_REDIS_NAMESPACE=lilac:session

# ------------------------------------------------------------------ 数据库连接池（可选）
DB_POOL_MAX_SIZE=20
DB_POOL_MIN_IDLE=5

# ------------------------------------------------------------------ 大模型
# 通义千问 DashScope（OpenAI 兼容模式）密钥
SPRING_AI_OPENAI_API_KEY=sk-change_me
SPRING_AI_OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode
SPRING_AI_OPENAI_MODEL=qwen-plus

# ------------------------------------------------------------------ Stripe
STRIPE_API_KEY=sk_test_change_me
STRIPE_WEBHOOK_SECRET=whsec_change_me
STRIPE_SUCCESS_URL=http://localhost:5173/recharge/success
STRIPE_CANCEL_URL=http://localhost:5173/recharge/cancel

# ------------------------------------------------------------------ 时区
TZ=Asia/Shanghai
